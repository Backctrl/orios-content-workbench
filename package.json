{
    "name":  "@orios/dsh-creator",
    "version":  "0.2.0",
    "description":  "OriOS 面向 DeepSeek Harness 的内容生产工作台插件：四级审批闸门（选题→长文→变体→发布）+ dsh-worktable 多窗口界面（顶栏+总览+编辑+预览）",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.19.0"
                },
    "main":  "lib/index.mjs",
    "exports":  {
                    ".":  "./lib/index.mjs",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-api-remotes",
                                              "@deepseek-ai/dsh-client-connection",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-settings-plugins",
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ],
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-client-ui-primitives":  "0.1.0-rc.6 || 0.1.0-rc.7 || 0.1.1-rc.2",
                             "react":  "^18.2.0"
                         },
    "dependencies":  {
                         "@deepseek-ai/dsh-tools":  "^0.1.1-rc.2",
                         "yaml":  "2.8.1"
                     },
    "files":  [
                  "lib",
                  "src",
                  "ui",
                  "skills",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "check":  "tsc --noEmit",
                    "build":  "tsdown",
                    "test":  "node test/smoke.mjs \u0026\u0026 node test/settings.mjs \u0026\u0026 node test/file-repository.mjs \u0026\u0026 node test/host-route.mjs \u0026\u0026 node test/creator-tools.mjs",
                    "check:all":  "npm run check \u0026\u0026 npm run build \u0026\u0026 npm test"
                },
    "license":  "MIT",
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "4.0.1",
                            "@deepseek-ai/dsh-client-runtime":  "0.1.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-primitives":  "^0.1.1-rc.2",
                            "@types/node":  "26.2.0",
                            "@types/react":  "18.3.31",
                            "@types/react-dom":  "18.3.7",
                            "react":  "18.3.1",
                            "react-dom":  "18.3.1",
                            "tsdown":  "0.22.14",
                            "typescript":  "7.0.2"
                        }
}